generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TargetType {
  COMPANY
  PERSON
}

model Target {
  id        String     @id @default(cuid())
  name      String
  type      TargetType @default(COMPANY)
  domain    String?
  notes     String?
  createdAt DateTime   @default(now())
  briefs    Brief[]
}

model Brief {
  id                 String   @id @default(cuid())
  targetId           String
  target             Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  summary            String
  recommendedActions String[]
  findings           Json
  sourcesConsidered  Int
  createdAt          DateTime @default(now())
}
